{
  "workflow_settings": {
    "max_iterations": 5,
    "timeout_seconds": 300,
    "retry_attempts": 3
  },
  "vllm_settings": {
    "gpu_memory_utilization": 0.8,
    "max_model_len": 4096,
    "tensor_parallel_size": 1
  },
  "sampling_params": {
    "temperature": 0.7,
    "top_p": 0.9,
    "max_tokens": 512,
    "frequency_penalty": 0.0,
    "presence_penalty": 0.0
  },
  "langgraph_config": {
    "enable_streaming": false,
    "max_concurrent_steps": 10,
    "checkpoint_interval": 100
  },
  "logging": {
    "level": "INFO",
    "enable_metrics": true,
    "metrics_interval": 60
  },
  "performance": {
    "batch_size": 8,
    "prefill_cache_size": 1000,
    "enable_chunked_prefill": true
  }
}